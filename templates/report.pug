div.report-header
  h2 Transactions avec 
    b= email

  div.balance
    if currentBalance < 0
      span.email= email
      span= " vous doit"  
      b.positive= ` ${Math.abs(Number(currentBalance).toFixed(2))}${currentCurrency.to_currency_symbol}`
    else        
      span= `Vous devez `
      b.negative= `${Math.abs(Number(currentBalance).toFixed(2))}${currentCurrency.to_currency_symbol}`
      span= " a "
      span.email= ` ${email}`


  div.section
    if items && items.length > 0
        each item in items
          div.transaction-card.item
            div.transaction-header
              span
                span.desc= item.description
                span.date= ` - [${item.date.toLocaleDateString()}]`
              if item.amount > 0
                span.amount.negative= `+ ${Math.abs(Number(item.amount).toFixed(2))}${item.currencySymbol}`
                  if item.currencySymbol !== currentCurrency.to_currency_symbol 
                    span.converted-amount= ` (${Math.abs(Number(item.convertedAmount).toFixed(2))}${currentCurrency.to_currency_symbol})`
              else
                span.amount.positive= `- ${Math.abs(Number(item.amount).toFixed(2))}${item.currencySymbol}`
                  if item.currencySymbol !== currentCurrency.to_currency_symbol 
                    span.converted-amount= ` (${Math.abs(Number(item.convertedAmount).toFixed(2))}${currentCurrency.to_currency_symbol})`

            div.transaction-details
              p
                strong Type: 
                span.type= item.type === 'debt' ? 'Depense' : 'Remboursement'
              p
                strong Payeur:  
                span= item.payerEmail  
              p
                strong Montant original: 
                span= Math.abs(Number(item.originalAmount).toFixed(2)) + item.currencySymbol


    div.recap-card
      div.recap-header
        h3 Récapitulatif
      div.recap-global
        p nb transactions: 
          span= items.length
        p à payer: 
          span= items.filter(item => item.amount > 0).length
        p à recevoir:    
          span= items.filter(item => item.amount < 0).length
      div.recap-global 
        p montant a payer: 
          span= items.filter(item => item.amount > 0).reduce((acc, item) => acc + Number.parseFloat(item.convertedAmount), 0).toFixed(2)
      div.recap-global 
        p montant a recevoir:                    
          span= items.filter(item => item.amount < 0).reduce((acc, item) => acc + Number.parseFloat(item.convertedAmount), 0).toFixed(2)       

    if (!items || items.length === 0)
      div.empty-state
        p No transactions found for this user.
