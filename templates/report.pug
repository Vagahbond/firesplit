div.report-header
  h2 Détail
  p.subtitle Historique des transactions avec 
    b= email

  p.subtitle Montant actuel de la dette: 
  if currentBalance < 0
    span.positive= `${email} vous doit ${Math.abs(Number(currentBalance).toFixed(2))}€`
  else        
    span.negative= `Vous devez ${Math.abs(Number(currentBalance).toFixed(2))}€ a ${email}`


  div.section
    if items && items.length > 0
        h3.section-title Transactions 
        each item in items
          div.transaction-card.item
            div.transaction-header
              span
                span.desc= item.description
                span.date= ` - [${item.date.toLocaleDateString()}]`
              if item.amount > 0
                span.amount.negative= `+ ${Math.abs(Number(item.amount).toFixed(2))}€`
              else
                span.amount.positive= `- ${Math.abs(Number(item.amount).toFixed(2))}€`
            div.transaction-details
              p
                strong Type: 
                span.type= item.type === 'debt' ? 'Depense' : 'Remboursement'
              p
                strong Payeur:  
                span= item.payerEmail  
              p
                strong Montant original: 
                span= Math.abs(Number(item.originalAmount).toFixed(2)) + ' €'


    if (!items || items.length === 0)
      div.empty-state
        p No transactions found for this user.
