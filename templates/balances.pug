each balance in balances
  div.balance-item
    - const amount = Number(balance.balance)
    - const absAmount = Math.abs(amount).toFixed(2)
    if amount < 0
      span.balance-amount.positive= `${absAmount}${currencySymbol}`
      span.situation &nbsp; dus 
        b.positive par&nbsp;
      a.balance-email(href="/report/" + balance.email)= balance.email
    else
      span.balance-amount.negative= `${absAmount}${currencySymbol}`
      span.situation &nbsp; dus 
        b.negative à&nbsp;
      a.balance-email(href="/report/" + balance.email)= balance.email
